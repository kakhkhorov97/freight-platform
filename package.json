{
  "name": "uzbekistan-freight-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Graduate thesis prototype for return-trip freight matching in Uzbekistan",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "build": "npm run build --workspace @freight/api",
    "start:api": "npm run start --workspace @freight/api",
    "test": "npm run test --workspace @freight/api"
  }
}
