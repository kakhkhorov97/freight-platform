{
  "name": "uzbekistan-freight-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Graduate thesis prototype for return-trip freight matching in Uzbekistan",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "build": "npm run build --workspaces --if-present",
    "start:api": "npm run start --workspace @freight/api",
    "test": "npm test --workspaces --if-present",
    "migration:create": "npm run migration:create --workspace @freight/api --",
    "migration:show": "npm run migration:show --workspace @freight/api --",
    "migration:run": "npm run migration:run --workspace @freight/api --",
    "migration:revert": "npm run migration:revert --workspace @freight/api --",
    "test:database": "npm run test:database --workspace @freight/api"
  },
  "engines": {
    "node": ">=24.9.0 <25"
  }
}
