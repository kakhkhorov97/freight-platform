{
  "name": "@freight/api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "build": "npm run build --workspace @freight/matcher && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "npm run build && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "migration:create": "typeorm migration:create",
    "migration:show": "npm run build && typeorm migration:show -d dist/database/data-source.js",
    "migration:run": "npm run build && typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/database/data-source.js",
    "test:database": "npm run build && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand --testMatch \"**/test/*.integration.cjs\""
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@freight/matcher": "0.0.0",
    "@nestjs/apollo": "14.2.0",
    "@nestjs/common": "12.4.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.0",
    "@nestjs/graphql": "14.2.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/typeorm": "12.0.3",
    "graphql": "16.15.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "jest": "30.5.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.spec.cjs"
    ],
    "transform": {}
  },
  "engines": {
    "node": ">=24.9.0 <25"
  }
}
